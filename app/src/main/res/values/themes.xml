<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal de la app (Material 3) -->
    <style name="Base.Theme.StreakfreeApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#8B5FBF</item>
        <item name="colorPrimaryDark">#6B59A1</item>
        <item name="colorAccent">#2ECC40</item>
        <item name="android:windowBackground">@color/purple_gradient_start</item>
    </style>

    <style name="Theme.StreakfreeApp" parent="Base.Theme.StreakfreeApp" />

    <!-- Tema SOLO para Login (sin Material Design) -->
    <style name="Theme.StreakfreeApp.Login" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#8B5FBF</item>
        <item name="colorPrimaryDark">#6B59A1</item>
        <item name="colorAccent">#2ECC40</item>
        <item name="android:windowBackground">@color/purple_gradient_start</item>

        <!-- Desactivar Material Design solo aquí -->
        <item name="materialButtonStyle">@style/Widget.AppCompat.Button</item>
        <item name="buttonStyle">@style/Widget.AppCompat.Button</item>
    </style>
</resources>