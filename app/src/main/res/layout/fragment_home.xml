<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Hola, usuario!"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Sigue construyendo tus hábitos"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/trophyIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/gray_background"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                tools:ignore="ContentDescription">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🏆"
                    android:textSize="28sp"
                    android:contentDescription="Trofeo de logros" />
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- Main Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_main_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/emoji_one"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚫"
                        android:textSize="32sp"
                        android:contentDescription="Icono de la adicción" />

                    <TextView
                        android:id="@+id/emoji_two"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textSize="32sp"
                        android:contentDescription="Segundo icono" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_main_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Agrega una adicción"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:contentDescription="Nombre de la adicción principal" />

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="1dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_current_streak"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="0"
                        android:textAlignment="textEnd"
                        android:layout_marginEnd="5dp"
                        android:textColor="@android:color/white"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:contentDescription="Racha actual en días" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:layout_marginBottom="4dp"
                        android:textSize="28sp"
                        android:contentDescription="Fuego que representa la racha" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="días"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:contentDescription="Texto 'días'" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Secondary Habits Row - Scrollable -->
        <HorizontalScrollView
            android:id="@+id/secondaryHabitsScroll"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:contentDescription="Desplázate horizontalmente para ver más adicciones">

            <LinearLayout
                android:id="@+id/secondaryHabitsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingEnd="16dp" />
        </HorizontalScrollView>

        <!-- Week Progress Title -->
        <TextView
            android:id="@+id/weekTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Esta semana..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:contentDescription="Título: Esta semana" />

        <!-- Week Days -->
        <LinearLayout
            android:id="@+id/weekDaysContainer"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_l"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginRight="4dp" />

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_m"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_mi"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_j"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_v"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_s"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <include
                layout="@layout/item_day_indicator"
                android:id="@+id/day_d"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <!-- Stats Row -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="85dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#7D5DB4"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:alpha="0.7"
                        android:text="Total"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:contentDescription="Total de días registrados" />

                    <TextView
                        android:id="@+id/txt_total_days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="36 días"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:contentDescription="Total de días: 36" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="85dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#7D5DB4"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈"
                            android:textSize="16sp"
                            android:contentDescription="Gráfico de tendencia" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:alpha="0.7"
                            android:text="Mejor racha"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:contentDescription="Texto: Mejor racha" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_best_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:text="18 días"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:contentDescription="Mejor racha: 18 días" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Achievements Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🏆 Logros"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="Título: Logros" />

        <!-- Achievements Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="top|center"
            android:orientation="horizontal">

            <include
                android:id="@+id/item_achievement_one"
                layout="@layout/item_achievement_one"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp" />

            <include
                android:id="@+id/item_achievement_two"
                layout="@layout/item_achievement_two"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp" />

            <include
                android:id="@+id/item_achievement_three"
                layout="@layout/item_achievement_three"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp" />

            <include
                android:id="@+id/item_achievement_four"
                layout="@layout/item_achievement_four"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_failed"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/red_failed"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:contentDescription="Botón: Marcar día fallado">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Marcar día fallado"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_completed"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/green_completed"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:contentDescription="Botón: Marcar día completado">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Marcar día completado"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>