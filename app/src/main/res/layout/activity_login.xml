<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo y título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/circle_placeholder"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="StreakFree"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:text="PlaceHolder"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Formulario de login/registro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/form_background"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Pestañas Iniciar Sesión / Registrarse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/tab_background"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTabLogin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp"
                android:text="Iniciar Sesión"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/boton_redondeado"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTabRegister"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:alpha="0.7"
                android:gravity="center"
                android:padding="10dp"
                android:text="Registrarse"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Contenedor para Iniciar Sesión -->
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Campo Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@android:color/white" />

                <EditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Correo electrónico o Nombre de usuario"
                    android:inputType="text"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Campo Contraseña -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="@android:color/white" />

                <EditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageViewShowPassword"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_partial_secure"
                    app:tint="@android:color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/textViewForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="14dp"
                android:alpha="0.8"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- Botón Iniciar Sesión -->
            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:background="@drawable/button_green"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:text="Iniciar Sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contenedor para Registrarse -->
        <LinearLayout
            android:id="@+id/layoutRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Nombre de usuario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@android:color/white" />

                <EditText
                    android:id="@+id/editTextName"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Nombre completo"
                    android:inputType="textPersonName"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Email Registro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@android:color/white" />

                <EditText
                    android:id="@+id/editTextEmailRegister"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Correo electrónico"
                    android:inputType="textEmailAddress"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Contraseña Registro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="@android:color/white" />

                <EditText
                    android:id="@+id/editTextPasswordRegister"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageViewShowPasswordRegister"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_partial_secure"
                    app:tint="@android:color/white" />

            </LinearLayout>

            <!-- Campo Confirmar Contraseña -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="@android:color/white" />

                <EditText
                    android:id="@+id/editTextConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Confirmar contraseña"
                    android:inputType="textPassword"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageViewShowConfirmPassword"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/ic_partial_secure"
                    app:tint="@android:color/white" />

            </LinearLayout>

            <!-- Botón Registrarse -->
            <Button
                android:id="@+id/buttonRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:background="@drawable/button_green"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:text="Registrarse"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- O continúa con (visible en ambas pestañas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:alpha="0.4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="O continúa con"
                android:textColor="@android:color/white"
                android:alpha="0.7"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:alpha="0.4" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonLoginGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/button_social"
            android:drawableStart="@drawable/google_icon_logo"
            android:gravity="center"
            android:padding="16dp"
            android:text="Continuar con Google"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <!-- Botón Facebook -->
        <Button
            android:id="@+id/buttonLoginFacebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/button_social"
            android:drawableStart="@drawable/iconfacebook"
            android:gravity="center"
            android:minHeight="20dip"
            android:padding="16dp"
            android:text="Continuar con Facebook"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <!-- Términos y condiciones -->
        <TextView
            android:id="@+id/textViewTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:gravity="center"
            android:text="Al continuar, aceptas nuestros Términos de Servicio y Política de Privacidad"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>